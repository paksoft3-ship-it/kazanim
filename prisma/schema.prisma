// Kazanım Gayrimenkul — data model
// Production: Vercel + Postgres (set a Kazanım-only DATABASE_URL; never reuse
// another project's database).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES
  HR
  VIEWER
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  HIDDEN
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

enum LeadType {
  CONTACT
  PROJECT_INFO
  APPOINTMENT
  PHONE
  WHATSAPP
  CAREER
  OTHER
}

enum LeadStatus {
  NEW
  READ
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SUITABLE
  NOT_SUITABLE
  ARCHIVED
}

// ─── Users & auth ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

// ─── Site settings ───────────────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ─── Editable pages ──────────────────────────────────────────────────────────

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  pageType       String        @default("standard")
  status         ContentStatus @default(PUBLISHED)
  heroTitle      String?
  heroSubtitle   String?
  heroImage      String?
  content        Json?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?
  canonicalUrl   String?
  robots         String        @default("index, follow")
  showInMenu     Boolean       @default(false)
  showInFooter   Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, sortOrder])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  slogan           String?
  status           ProjectStatus @default(ONGOING)
  publishStatus    ContentStatus @default(PUBLISHED)
  type             String?
  location         String?
  mapsUrl          String?
  shortDescription String?
  description      String?
  coverImage       String?
  gallery          Json?
  progressOverall  Int           @default(0)
  progressItems    Json?
  features         Json?
  technicalDetails Json?
  documents        Json?
  videoUrl         String?
  startDate        DateTime?
  deliveryDate     DateTime?
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  canonicalUrl     String?
  robots           String        @default("index, follow")
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  media    MediaAsset[]
  news     NewsArticle[]
  leads    Lead[]

  @@index([status, publishStatus])
  @@index([isFeatured])
}

// ─── Media ───────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String   @id @default(cuid())
  fileName    String
  url         String
  altText     String?
  title       String?
  description String?
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  category    String   @default("genel")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linkedProjectId String?
  linkedProject   Project? @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([linkedProjectId])
}

// ─── News ────────────────────────────────────────────────────────────────────

model NewsArticle {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?
  content        String?
  coverImage     String?
  category       String        @default("Kurumsal")
  status         ContentStatus @default(PUBLISHED)
  isFeatured     Boolean       @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  canonicalUrl   String?
  robots         String        @default("index, follow")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  relatedProjectId String?
  relatedProject   Project? @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([category])
}

// ─── Leads ───────────────────────────────────────────────────────────────────

model Lead {
  id            String     @id @default(cuid())
  type          LeadType   @default(CONTACT)
  name          String
  phone         String
  email         String?
  subject       String?
  message       String?
  sourcePage    String?
  landingPage   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  gclid         String?
  gbraid        String?
  wbraid        String?
  fbclid        String?
  msclkid       String?
  status        LeadStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type])
}

// ─── HR ──────────────────────────────────────────────────────────────────────

model JobPosition {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  department       String?
  location         String?
  type             String?
  description      String?
  requirements     String?
  responsibilities String?
  status           ContentStatus @default(PUBLISHED)
  sortOrder        Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id            String            @id @default(cuid())
  name          String
  phone         String
  email         String?
  message       String?
  cvUrl         String?
  status        ApplicationStatus @default(NEW)
  internalNotes String?
  sourcePage    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  positionId String?
  position   JobPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ─── Redirects ───────────────────────────────────────────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
