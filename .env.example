# ─── Public site identity ────────────────────────────────────────────────────
# Final domain not confirmed yet. Leave empty until the production domain is
# live; while empty, all deployments render noindex/nofollow and robots.txt
# disallows crawling. Set e.g. https://www.example.com after confirmation.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME="Kazanım Gayrimenkul"

# ─── Tracking (GTM / GA4 / Google Ads) ───────────────────────────────────────
# Use NEW Kazanım-only IDs. Never reuse another site's container or property.
# Conversion IDs are NOT hard-coded in the app; GTM maps the dataLayer events
# documented in docs/tracking.md to GA4 key events and Ads conversions.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ENABLE_DATALAYER=true
NEXT_PUBLIC_ENABLE_CONSENT_MODE=true
NEXT_PUBLIC_TRACKING_DEBUG=false

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Create a NEW database for Kazanım (Neon/Vercel Postgres or local Docker).
# Never point this at another project's database.
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a NEW secret with: openssl rand -base64 32
# The seed only creates the admin account from these values; in production the
# seed refuses to create a default account when they are missing.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Storage (image/CV uploads) ──────────────────────────────────────────────
# Use a NEW Vercel Blob store for Kazanım. When empty, uploads fall back to
# local /public/uploads (development only).
BLOB_READ_WRITE_TOKEN=

# ─── Email notifications (optional) ──────────────────────────────────────────
# Form notification e-mails are only sent when SMTP_HOST is configured.
# Lead capture never depends on e-mail delivery succeeding.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FORM_NOTIFICATION_EMAIL=

# ─── Seed behaviour ──────────────────────────────────────────────────────────
# Demo projects/news/gallery/positions seed automatically in development.
# On production (VERCEL_ENV=production) they are skipped unless this is "true".
# Set to "false" to skip demo content anywhere.
SEED_DEMO_CONTENT=
